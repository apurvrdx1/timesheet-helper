{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode. `bundler` rather than `nodenext` because Vitest runs
       these files through Vite's transform, not through Node's own ESM
       resolver -- and because the integration suites import app modules from
       `src/`, which are written for the bundler resolution `tsconfig.app.json`
       uses. Under `nodenext` every one of those modules' own extensionless
       relative imports would have to gain a `.js` suffix purely to satisfy a
       resolver nothing at runtime actually uses. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "vitest.integration.config.ts", "src/**/*.integration.test.ts"]
}
